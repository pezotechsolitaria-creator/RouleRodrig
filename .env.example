# ── Roule Rodrigues — environment variables ─────────────────────────────────
# Copy to .env.local for development. On Vercel: Settings → Environment Variables.
# Most integrations can ALSO be configured from Admin → Alerts & Email with no
# redeploy — admin-saved values take priority over these env vars.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...   # server-only; never expose to the client

# Admin (required)
ADMIN_PASSWORD=choose-a-long-unique-password
SESSION_SECRET=any-long-random-string      # rotating it logs out all sessions

# Customer emails — Brevo (or set from Admin → Alerts & Email)
BREVO_API_KEY=xkeysib-...
BREVO_FROM=Roule Rodrigues <you@gmail.com> # must be a verified Brevo sender
BREVO_LIST_ID=3                            # optional: contacts auto-join this list

# Customer emails — Resend alternative (needs a verified domain)
# RESEND_API_KEY=re_...
# RESEND_FROM=Roule Rodrigues <hello@yourdomain.com>

# Owner notifications
OWNER_EMAIL=you@gmail.com                  # receives booking alerts
OWNER_WHATSAPP=23058355588                 # used in email WhatsApp buttons
# CallMeBot WhatsApp alerts (or set from Admin → Alerts & Email)
CALLMEBOT_PHONE=23058355588
CALLMEBOT_APIKEY=1234567

# Optional
GOOGLE_REVIEW_URL=https://g.page/r/...     # feedback emails link here
HOLD_EXPIRY_HOURS=48                       # pending bookings auto-release after this
